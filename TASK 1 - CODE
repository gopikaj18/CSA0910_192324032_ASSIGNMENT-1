import java.time.LocalDateTime;
import java.util.Objects;
public class Task1Demo {
    static class Vehicle {
        private final String regNo;
        private final String type;
        Vehicle(String regNo, String type) {
            if (regNo == null || regNo.isBlank()) throw new IllegalArgumentException("Registration required");
            this.regNo = regNo.toUpperCase();
            this.type = Objects.requireNonNull(type);
        }
        String getRegNo() { return regNo; }
        String getType() { return type; }
    }
    static class ParkingTicket {
        private static int nextId = 1;
        private final String ticketNo = "T-" + nextId++;
        private final Vehicle vehicle;
        private final LocalDateTime entryTime = LocalDateTime.now();
        ParkingTicket(Vehicle vehicle) { this.vehicle = Objects.requireNonNull(vehicle); }
        String getTicketNo() { return ticketNo; }
        Vehicle getVehicle() { return vehicle; }
        LocalDateTime getEntryTime() { return entryTime; }
    }
    public static void main(String[] args) {
        Vehicle v = new Vehicle("tn01ab1234", "Car");
        ParkingTicket t = new ParkingTicket(v);
        System.out.println("Vehicle: " + t.getVehicle().getRegNo());
        System.out.println("Type: " + t.getVehicle().getType());
        System.out.println("Ticket: " + t.getTicketNo());
        System.out.println("Entry: " + t.getEntryTime());
    }
}
