public class Task2Demo {
    public static void main(String[] args) {
        int[] slotsPerFloor = {2, 3, 1};
        String[][] slots = new String[slotsPerFloor.length][];
        for (int f = 0; f < slotsPerFloor.length; f++) {
            slots[f] = new String[slotsPerFloor[f]];
        }
        slots[0][0] = "TN01AB1234";
        int minutes = 61;
        int billableHours = minutes == 0 ? 0 : (minutes + 59) / 60;
        double ratePerHour = 30.0;
        double fee = billableHours * ratePerHour;
        System.out.println("Floors: " + slots.length);
        System.out.println("Slots on floor 1: " + slots[0].length);
        System.out.println("Vehicle at [0][0]: " + slots[0][0]);
        System.out.println("Fee for 61 minutes: Rs " + fee);
    }
}
